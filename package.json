{
  "name": "brand-ownership-visualization",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "logo-search": "tsx scripts/logo-searcher.ts",
    "logo-search:resume": "tsx scripts/logo-searcher.ts --resume",
    "logo-search:test": "tsx scripts/logo-searcher.ts --limit=5",
    "logo-standardize": "tsx scripts/logo-standardizer.ts",
    "logo-standardize:resume": "tsx scripts/logo-standardizer.ts --resume",
    "logo-standardize:test": "tsx scripts/logo-standardizer.ts --limit=5",
    "logo-standardize:stats": "tsx scripts/logo-standardizer.ts --stats",
    "migrate:appwrite": "tsx scripts/migrate-to-appwrite.ts",
    "migrate:appwrite:dry-run": "tsx scripts/migrate-to-appwrite.ts --dry-run",
    "migrate:appwrite:companies": "tsx scripts/migrate-to-appwrite.ts --companies-only",
    "migrate:appwrite:brands": "tsx scripts/migrate-to-appwrite.ts --brands-only",
    "migrate:logos": "tsx scripts/upload-logos-to-appwrite.ts",
    "migrate:logos:dry-run": "tsx scripts/upload-logos-to-appwrite.ts --dry-run",
    "migrate:logos:resume": "tsx scripts/upload-logos-to-appwrite.ts --skip-existing"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/sharp": "^0.31.1",
    "@vueuse/core": "^13.6.0",
    "appwrite": "^16.0.2",
    "autoprefixer": "^10.4.21",
    "d3": "^7.9.0",
    "lucide-vue-next": "^0.536.0",
    "pinia": "^3.0.3",
    "postcss": "^8.5.6",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.11",
    "vite": "npm:rolldown-vite@latest",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/experimental-ct-vue": "^1.54.2",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "oxlint": "^1.9.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vue-tsc": "^2.2.12"
  }
}
