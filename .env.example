# Appwrite Configuration
# Copy this file to .env and fill in your Appwrite project details

# Appwrite Endpoint (Cloud or Self-Hosted)
# Cloud: https://cloud.appwrite.io/v1
# Self-hosted: https://your-domain.com/v1
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Appwrite Project ID
# Get this from Appwrite Console > Settings > Project ID
VITE_APPWRITE_PROJECT=your-project-id-here

# Appwrite API Key (Server-Side Only - DO NOT COMMIT)
# Only needed for migration scripts and server-side operations
# Get this from Appwrite Console > Settings > API Keys
# Required scopes: databases.write, storage.write
# IMPORTANT: Add .env to .gitignore to prevent committing this key
APPWRITE_API_KEY=your-api-key-here

# Optional: Database and Collection IDs (defaults in code if not set)
# APPWRITE_DATABASE_ID=brands_db
# APPWRITE_COMPANIES_COLLECTION=companies
# APPWRITE_BRANDS_COLLECTION=brands
# APPWRITE_LOGOS_BUCKET=brand-logos
